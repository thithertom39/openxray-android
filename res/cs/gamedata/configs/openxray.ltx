[environment]
; Set to false if you want weather config defined sun movement
dynamic_sun_dir = true

; Defines sun movement direction
; Useless if dynamic_sun_dir is disabled
sun_dir_azimuth = 0.0

[gameplay]
; You can set camera behaviour on actor death
; Allowed values: firsteye, freelook, fixedlook
; Note, that the player can turn on firsteye himself
; if you set freelook or fixedlook
actor_death_camera = freelook
currency = RU

[lua_scripting]
; This will allow you to skip errors
; related to wrong arguments passed
; to functions.
; WARNING. This may lead to
; undefined behavior, random crashes
; and saves corruption
; CS and SOC are older games whose scripts routinely pass nil through
; bindings; the engine default is true, and with this false a single nil
; return raises "attempt to index a nil value" from inside luabind's
; __index, which kills unrelated script code (bind_stalker.script:73).
allow_nil_conversion = true

; If false partially disables new LuaJIT escape sequences
; that break compatibility with original game scripts.
allow_escape_sequences = false

[compatibility]
; Compatibility with previous games
; cop, cs, shoc or soc and unlock
; unlock is cop with disabled restrictions
game_mode = cs

; Always try to put item in the slot, SOC behaviour
; For the comparison, COP tries to do that only if item has default_to_ruck = false
default_to_slot = false

; SOC/CS slots ordering
; e.g. knife slot is 0 in SOC/CS and 1 in COP
; script_game_object_inventory_owner.cpp:1302 does ++slot_id when this is
; true, and its own default for CS/SoC is true. Leaving it false here skipped
; that shift, so every actor:item_in_slot(n) in the CS scripts read the wrong
; slot -- which is why no weapon could be drawn.
minus_one_slot_ordering = true

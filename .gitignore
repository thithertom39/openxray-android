.vs/
*.user
*.userosv
*.user.props
*.suo
*.su
*.sln.docstates
*.opensdf
*.sdf
*.VC.opendb
*.VC.db
*.PVS-Studio.*
*.nvuser

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# JetBrains (CLion / Android Studio / IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code (except settings/launch templates if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# C / C++ Build Artifacts & Binaries
# ------------------------------------------------------------------------------
[Bb]in/
[Bb]uild*/
[Ll]ib/
x64/
x86/
arm64/
arm64-v8a/
armeabi-v7a/

